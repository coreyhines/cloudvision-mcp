# Podman quadlet: shared pod for CloudVision MCP + Caddy auth/TLS front.
# Install to /etc/containers/systemd/cloudvision-mcp/cloudvision-mcp.pod
# systemd unit: cloudvision-mcp-pod.service

[Unit]
Description=CloudVision MCP pod (shared network for Caddy + MCP)
Wants=network-online.target
After=network-online.target

[Pod]
PodName=cloudvision-mcp-pod
# Optional custom network / static addresses:
# Network=net-10
# IP=10.0.10.18
# IP6=2601:441:8400:b7e1::18
# DNS=10.0.2.2

# Quadlet defaults a pod to --exit-policy stop, which stops the whole pod when
# its last container exits. Member containers are BindsTo= the pod unit, so
# `systemctl restart cloudvision-mcp-app` would stop the pod and then fail with
# "Bound to unit cloudvision-mcp-pod.service, but unit isn't active", taking the
# whole deployment down until the pod was started by hand. Keeping the pod alive
# lets one container be restarted on its own.
ExitPolicy=continue

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
